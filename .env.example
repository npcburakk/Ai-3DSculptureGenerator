# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME="Text-to-3D Generator"
APP_VERSION="1.0.0"
DEBUG=false

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
# Comma-separated origins, or ["*"] to allow all
CORS_ORIGINS=["*"]

# ── Output ────────────────────────────────────────────────────────────────────
OUTPUT_DIR=outputs
DEFAULT_OUTPUT_FORMAT=obj    # obj | ply | glb

# ── Backend ───────────────────────────────────────────────────────────────────
# Options: meshy | shap_e | mock
DEFAULT_BACKEND=meshy

# Mock backend is hidden from the UI. Set to true to allow testing it via the
# API directly (curl/Postman). It never appears in the frontend regardless.
ENABLE_MOCK_BACKEND=false

# ── OpenAI API (required only for backend=openai) ─────────────────────────────
OPENAI_API_KEY=

# ── Shap-E / Point-E settings ─────────────────────────────────────────────────
SHAP_E_GUIDANCE_SCALE=15.0
SHAP_E_NUM_STEPS=64
SHAP_E_RENDER_MODE=stf      # stf | nerf
MESH_RESOLUTION=128

# ── Job Limits ────────────────────────────────────────────────────────────────
MAX_CONCURRENT_JOBS=2
JOB_TIMEOUT_SECONDS=600
MAX_PROMPT_LENGTH=500

# ── Meshy API ───────────────────────────────────────────────────────────────────
MESHY_API_KEY=

# Generate your own random secret, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-in-production-use-a-long-random-string
