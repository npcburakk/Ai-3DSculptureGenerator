# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME="Text-to-3D Generator"
APP_VERSION="1.0.0"
DEBUG=false

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
# Comma-separated origins, or ["*"] to allow all
CORS_ORIGINS=["*"]

# ── Output ────────────────────────────────────────────────────────────────────
OUTPUT_DIR=outputs
DEFAULT_OUTPUT_FORMAT=obj    # obj | ply | glb

# ── Backend ───────────────────────────────────────────────────────────────────
# Options: shap_e | point_e | mock
DEFAULT_BACKEND=shap_e

# ── OpenAI API (required only for backend=openai) ─────────────────────────────
OPENAI_API_KEY= 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

# ── Shap-E / Point-E settings ─────────────────────────────────────────────────
SHAP_E_GUIDANCE_SCALE=15.0
SHAP_E_NUM_STEPS=64
SHAP_E_RENDER_MODE=stf      # stf | nerf
MESH_RESOLUTION=128

# ── Job Limits ────────────────────────────────────────────────────────────────
MAX_CONCURRENT_JOBS=2
JOB_TIMEOUT_SECONDS=600
MAX_PROMPT_LENGTH=500

# ── Meshy API ───────────────────────────────────────────────────────────────────
MESHY_API_KEY = msy_0mLRVangQIfaxCPcJwmTbCDs7bRuWlc1sA35
